<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.beatgridmedia.measurementkit</groupId>
    <artifactId>measurementkit-workspace</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <!--
        Same layering as the production server:
        - *-database:    Flyway migrations (SQL only)
        - *-persistence: Hibernate/JPA entities and Spring Data repositories
        - *-service:     business logic (transactions live here)
        - *-controller:  REST controllers + DTOs
        - *-application: Spring Boot application, configuration, security
    -->
    <modules>
        <module>beatkit/beatkit-core-persistence</module>
        <module>measurementkit/measurementkit-database</module>
        <module>measurementkit/measurementkit-persistence</module>
        <module>measurementkit/measurementkit-service</module>
        <module>measurementkit/measurementkit-controller</module>
        <module>measurementkit/measurementkit-application</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.beatgridmedia.measurementkit</groupId>
                <artifactId>beatkit-core-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.beatgridmedia.measurementkit</groupId>
                <artifactId>measurementkit-database</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.beatgridmedia.measurementkit</groupId>
                <artifactId>measurementkit-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.beatgridmedia.measurementkit</groupId>
                <artifactId>measurementkit-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.beatgridmedia.measurementkit</groupId>
                <artifactId>measurementkit-controller</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
